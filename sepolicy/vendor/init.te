allow init vendor_file:file r_file_perms;
allow init same_process_hal_file:file { execute };
allow init hwservicemanager:binder { call };
allow init adsprpcd_file:file mounton;
set_prop(init, vendor_camera_prop)

# Smart charging
allow init sysfs_battery_supply:file { setattr };

allow init property_type:file { append create getattr map open read relabelto rename setattr unlink write };
allow init bt_firmware_file:filesystem { getattr } ;
allow init default_android_hwservice:hwservice_manager { add find } ;
allow init firmware_file:filesystem { getattr } ;
allow init hal_light_hwservice:hwservice_manager { add } ;
allow init hal_misys_hwservice:hwservice_manager { add } ;
allow init hal_power_stats_hwservice:hwservice_manager { add } ;
allow init hidl_base_hwservice:hwservice_manager { add } ;
allow init hwservicemanager:binder { transfer } ;
allow init sysfs:file { open read write } ;
allow init sysfs_graphics:file { open read write } ;
allow init sysfs_graphics:lnk_file { read } ;
allow init sysfs_kgsl:file { open read } ;
allow init system_file:file { execute_no_trans execute } ;
allow init vendor_toolbox_exec:file { execute_no_trans } ;
allow init vndbinder_device:chr_file { ioctl map open read write } ;
allow init vendor_file:file { execute execute_no_trans } ;
